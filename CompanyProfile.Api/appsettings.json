{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200"
    ]
  },
  "AppSettings": {
    "Session": {
      "CookieName": "__Host-user_session",
      "SessionLifetimeDays": 14,
      "RenewalThresholdDays": 1,
      "AbsoluteSessionLifetimeDays": 60
    }
  }
}
