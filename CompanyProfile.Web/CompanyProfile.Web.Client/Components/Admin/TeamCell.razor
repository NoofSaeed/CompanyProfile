@using CompanyProfile.Shared.DTOs
@if (Item is null)
{
    <button class="service-language-add" type="button" @onclick="() => OnAdd.InvokeAsync((MemberId, Language))">+ Add @Language</button>
}
else
{
    <div class="service-language-cell"><strong>@Item.Name</strong><small>@Item.Role<br />@Item.Bio</small><button type="button" @onclick="() => OnEdit.InvokeAsync(Item)">Edit</button></div>
}
@code {
    [Parameter] public TeamMemberResponseDto? Item { get; set; }
    [Parameter] public int MemberId { get; set; }
    [Parameter] public string Language { get; set; } = string.Empty;
    [Parameter] public EventCallback<(int Id, string Language)> OnAdd { get; set; }
    [Parameter] public EventCallback<TeamMemberResponseDto> OnEdit { get; set; }
}
