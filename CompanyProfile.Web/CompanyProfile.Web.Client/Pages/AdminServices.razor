@page "/admin/services"
@layout AdminLayout
@using CompanyProfile.Shared.DTOs
@using CompanyProfile.Web.Client.Components.Admin
@using CompanyProfile.Web.Client.Services
@inject CompanyApiClient CompanyApiClient
@inject IJSRuntime JS

<PageTitle>Services</PageTitle>
<header class="admin-topbar">
    <div><h1>Services</h1></div>
    <a class="admin-view-site" href="/" target="_blank">View website ↗</a>
</header>

<section class="admin-panel">
    <div class="admin-panel-heading">
        <div><p class="admin-eyebrow">SERVICE DIRECTORY</p><h2>All services</h2></div>
        <button class="admin-primary-button" type="button" @onclick="OpenCreate">Add service <span>+</span></button>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead><tr><th>ID</th><th>Icon</th><th>Arabic</th><th>English</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="table-id">@row.Id</td>
                        <td>
                            <div class="service-icon-cell">
                                <span class="admin-record-icon">@row.Icon</span>
                                <button class="service-icon-edit" type="button" @onclick="() => OpenIconEdit(row)">Edit icon</button>
                            </div>
                        </td>
                        <td><ServiceCell Item="row.Arabic" Language="ar" ServiceId="row.Id" OnAdd="args => OpenTranslation(args.Id, args.Language)" OnEdit="item => OpenEdit(item)" /></td>
                        <td><ServiceCell Item="row.English" Language="en" ServiceId="row.Id" OnAdd="args => OpenTranslation(args.Id, args.Language)" OnEdit="item => OpenEdit(item)" /></td>
                        <td><button class="admin-table-delete" type="button" @onclick="() => DeleteAsync(row.Id)">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (rows.Count == 0) { <p class="admin-muted table-empty">No services found.</p> }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="admin-status admin-status-error">@statusMessage</p>
}

@if (editor is not null)
{
    <ServiceEditor ServiceId="@editor.Id" Language="@editor.Language" InitialTitle="@editor.Title" InitialDescription="@editor.Description" InitialIcon="@editor.Icon" IsIconEdit="@editor.IsIconEdit" IsEdit="@editor.IsEdit" IsSaving="@isSaving" OnSubmit="SaveEditorAsync" OnClose="CloseEditor" />
}

@code {
    private List<ServiceRow> rows = [];
    private EditorState? editor;
    private bool isSaving;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var arabic = await CompanyApiClient.GetServicesAsync("ar");
        var english = await CompanyApiClient.GetServicesAsync("en");
        rows = arabic.Select(x => new ServiceRow(x.Id, x.Icon, x, english.FirstOrDefault(y => y.Id == x.Id)))
            .Concat(english.Where(x => arabic.All(y => y.Id != x.Id)).Select(x => new ServiceRow(x.Id, x.Icon, null, x)))
            .OrderBy(x => x.Id)
            .ToList();
    }

    private void OpenCreate() => editor = new EditorState(null, "ar", string.Empty, string.Empty, string.Empty);

    private void OpenTranslation(int id, string language)
        => editor = new EditorState(id, language, string.Empty, string.Empty, rows.First(x => x.Id == id).Icon);

    private void OpenEdit(ServiceResponseDto item)
        => editor = new EditorState(item.Id, item.Language, item.Title, item.Description, item.Icon, false, true);

    private void OpenIconEdit(ServiceRow row)
    {
        var item = row.Arabic ?? row.English;
        if (item is not null)
            editor = new EditorState(item.Id, item.Language, item.Title, item.Description, item.Icon, true);
    }

    private async Task SaveEditorAsync(ServiceEditor.ServiceEditorResult result)
    {
        isSaving = true;
        ServiceResponseDto? saved;
        string? errorMessage = null;
        if (result.Id.HasValue && editor?.IsIconEdit == true)
            saved = await CompanyApiClient.UpdateServiceAsync(result.Id.Value, result.Language, new UpdateServiceDto(result.Title, result.Description, result.Icon));
        else if (result.Id.HasValue && editor?.IsEdit == true)
        {
            var response = await CompanyApiClient.UpdateServiceResponseAsync(result.Id.Value, result.Language, new UpdateServiceDto(result.Title, result.Description, result.Icon));
            saved = response?.Data;
            errorMessage = response?.Message;
        }
        else if (result.Id.HasValue)
        {
            var response = await CompanyApiClient.AddServiceTranslationResponseAsync(result.Id.Value, result.Language, new CreateServiceTranslationDto(result.Title, result.Description));
            saved = response?.Data;
            errorMessage = response?.Message;
        }
        else
            saved = await CompanyApiClient.AddServiceAsync(result.Language, new CreateServiceDto(result.Title, result.Description, result.Icon));

        isSaving = false;
        if (saved is not null)
        {
            editor = null;
            await LoadAsync();
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
            statusMessage = errorMessage;
    }

    private Task CloseEditor() { editor = null; return Task.CompletedTask; }

    private async Task DeleteAsync(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this service? This action cannot be undone."))
            return;

        if (await CompanyApiClient.DeleteServiceAsync(id))
            await LoadAsync();
    }

    private sealed record ServiceRow(int Id, string Icon, ServiceResponseDto? Arabic, ServiceResponseDto? English);
    private string? statusMessage;
    private sealed record EditorState(int? Id, string Language, string Title, string Description, string Icon, bool IsIconEdit = false, bool IsEdit = false);
}
